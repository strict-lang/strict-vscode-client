{
  "name": "strict-language",
  "displayName": "Strict Language",
  "description": "Language support for Strict: completion, hover, go to definition, implementations suggested from your tests, errors for methods that already exist, SCrunch inline tests, validator diagnostics, quick fixes and run commands, all through the native Strict compiler. See https://strict-lang.org/",
  "version": "0.1.0",
  "publisher": "strict-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/strict-lang/strict-vscode-client"
  },
  "homepage": "https://strict-lang.org/",
  "bugs": {
    "url": "https://github.com/strict-lang/strict-vscode-client/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "strict",
    "strict-lang",
    "scrunch"
  ],
  "activationEvents": [
    "onLanguage:strict",
    "workspaceContains:**/*.strict"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "strict-vscode-client.runFile",
        "title": "Strict: Run File",
        "icon": "$(play)"
      },
      {
        "command": "strict-vscode-client.run",
        "title": "Strict: Run File with Arguments..."
      },
      {
        "command": "strict-vscode-client.scrunch.focus",
        "title": "Show in Testing window"
      },
      {
        "command": "strict-vscode-client.scrunch.showLineTests",
        "title": "SCrunch: Show Tests for Line"
      },
      {
        "command": "strict-vscode-client.scrunch.slowestTests",
        "title": "SCrunch: Show Slowest Tests",
        "icon": "$(watch)"
      },
      {
        "command": "strict-vscode-client.scrunch.timeAll",
        "title": "SCrunch: Time All Tests (without cache)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceLangId == strict",
          "group": "navigation"
        }
      ],
      "testing/item/gutter": [
        {
          "command": "strict-vscode-client.scrunch.focus",
          "when": "resourceExtname == .strict",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceLangId == strict",
          "group": "navigation@1"
        },
        {
          "command": "strict-vscode-client.run",
          "when": "resourceLangId == strict",
          "group": "navigation@2"
        },
        {
          "command": "strict-vscode-client.scrunch.showLineTests",
          "when": "resourceLangId == strict",
          "group": "navigation@3"
        },
        {
          "command": "strict-vscode-client.scrunch.focus",
          "when": "resourceLangId == strict",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.run",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.scrunch.focus"
        },
        {
          "command": "strict-vscode-client.scrunch.showLineTests",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.scrunch.slowestTests"
        },
        {
          "command": "strict-vscode-client.scrunch.timeAll"
        }
      ]
    },
    "keybindings": [
      {
        "command": "strict-vscode-client.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && resourceLangId == strict"
      },
      {
        "command": "editor.action.quickFix",
        "key": "alt+enter",
        "when": "editorTextFocus && editorHasCodeActionsProvider && resourceLangId == strict"
      }
    ],
    "taskDefinitions": [
      {
        "type": "strict",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": ".strict file with a Run method, relative to the workspace folder"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments passed to Run"
          }
        }
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.patterns": {
        "*.strict": "${capture}.strictbinary"
      },
      "[strict]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": true
      }
    },
    "configuration": {
      "title": "Strict",
      "properties": {
        "strict.slowTestMilliseconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "Tests (and all tests of a method, on its header) taking at least this long show `slow: …` after the line. Most types run all their tests in under 1 ms. **SCrunch: Show Slowest Tests** lists the slowest ones."
        },
        "strict.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Strict folder containing `strict.exe` and the base `.strict` types. Empty = the newest `strict` of the workspace or a sibling `Strict` repository, else the first on PATH, else the copy bundled in the .vsix."
        }
      }
    },
    "languages": [
      {
        "id": "strict",
        "aliases": [
          "Strict",
          "strict"
        ],
        "extensions": [
          ".strict"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "strict",
        "scopeName": "source.strict",
        "path": "./syntaxes/strict.tmLanguage"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && bun strict.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test:unit": "bun run compile && bun out/test/unit/runUnitTests.js",
    "test": "bun run test:unit && bun run lint",
    "package": "tsc -p ./ && bun strict.mjs package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.0.1",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  }
}
