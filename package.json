{
  "name": "strict-language",
  "displayName": "Strict Language",
  "description": "Language support for Strict: completion, hover, go to definition, implementations suggested from your tests, errors for methods that already exist, SCrunch inline tests, validator diagnostics, quick fixes and run commands, all through the native Strict compiler. See https://strict-lang.org/",
  "version": "1.0.20261022",
  "publisher": "strict-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/strict-lang/strict-vscode-client"
  },
  "homepage": "https://strict-lang.org/",
  "bugs": {
    "url": "https://github.com/strict-lang/strict-vscode-client/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other",
    "Formatters"
  ],
  "keywords": [
    "strict",
    "strict-lang",
    "scrunch"
  ],
  "activationEvents": [
    "workspaceContains:**/*.strict"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "strict-vscode-client.runFile",
        "title": "Run File",
        "category": "Strict",
        "icon": "$(play)"
      },
      {
        "command": "strict-vscode-client.run",
        "title": "Run File with Arguments...",
        "category": "Strict",
        "icon": "$(play-circle)"
      },
      {
        "command": "strict-vscode-client.scrunch.focus",
        "title": "Show in Testing window",
        "category": "SCrunch",
        "icon": "$(beaker)"
      },
      {
        "command": "strict-vscode-client.scrunch.showLineTests",
        "title": "Show Tests for Line",
        "category": "SCrunch"
      },
      {
        "command": "strict-vscode-client.scrunch.slowestTests",
        "title": "Show Slowest Tests",
        "category": "SCrunch",
        "icon": "$(watch)"
      },
      {
        "command": "strict-vscode-client.scrunch.timeAll",
        "title": "Time All Tests (without cache)",
        "category": "SCrunch"
      },
      {
        "command": "strict-vscode-client.buildNative",
        "title": "Build Native Executable",
        "category": "Strict",
        "icon": "$(package)"
      },
      {
        "command": "strict-vscode-client.updatePackages",
        "title": "Update Packages",
        "category": "Strict"
      },
      {
        "command": "strict-vscode-client.selectRoot",
        "title": "Select Strict Folder",
        "category": "Strict"
      },
      {
        "command": "strict-vscode-client.evaluate",
        "title": "Evaluate",
        "category": "Strict"
      },
      {
        "command": "strict-vscode-client.getStarted",
        "title": "Get Started",
        "category": "Strict"
      },
      {
        "command": "strict-vscode-client.buildPlatform",
        "title": "Build for Platform...",
        "category": "Strict",
        "icon": "$(package)"
      }
    ],
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get Started with Strict",
        "description": "Write, run, test and build your first Strict program in a few minutes.",
        "steps": [
          {
            "id": "website",
            "title": "Meet Strict",
            "description": "Strict is a simple language humans and computers can read, write and understand, every method starts with its tests. strict-lang.org explains it with examples.\n[Show strict-lang.org](command:simpleBrowser.show?%5B%22https%3A%2F%2Fstrict-lang.org%22%5D)",
            "media": {
              "image": "media/StrictBanner.png",
              "altText": "Strict Programming Language"
            },
            "completionEvents": [
              "onCommand:simpleBrowser.show"
            ]
          },
          {
            "id": "hello",
            "title": "Hello World",
            "description": "Create a Strict file, type `run` and press **Tab** for a `Run` method, save it as **Hello.strict**. Run it with **Ctrl+Shift+R** or **Run** above `Run`.\n[New Strict File](command:workbench.action.files.newUntitledFile?%7B%22languageId%22%3A%22strict%22%7D)",
            "media": {
              "markdown": "media/hello.md"
            },
            "completionEvents": [
              "onCommand:strict-vscode-client.runFile"
            ]
          },
          {
            "id": "test",
            "title": "Test",
            "description": "Tests run while you type (Strict files save themselves): the gutter shows passed and failed tests right away, errors, inline failures and the Testing view follow once you stop typing for a second. **Shift+Enter** evaluates a selection.\n[Open Testing](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "media/test.md"
            },
            "completionEvents": [
              "onCommand:workbench.view.testing.focus"
            ]
          },
          {
            "id": "build",
            "title": "Build",
            "description": "**Build Native** above `Run` (or **Strict: Build Native Executable**) runs the tests, then builds a native executable next to the file, on Windows also one for Linux through WSL.",
            "media": {
              "markdown": "media/build.md"
            },
            "completionEvents": [
              "onCommand:strict-vscode-client.buildNative"
            ]
          }
        ]
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceLangId == strict",
          "group": "navigation@1"
        },
        {
          "command": "strict-vscode-client.run",
          "when": "resourceLangId == strict",
          "group": "navigation@2"
        },
        {
          "command": "strict-vscode-client.buildPlatform",
          "when": "resourceLangId == strict",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "strict-vscode-client.scrunch.focus",
          "when": "resourceLangId == strict",
          "group": "navigation"
        }
      ],
      "testing/item/gutter": [
        {
          "command": "strict-vscode-client.scrunch.focus",
          "when": "resourceExtname == .strict",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceLangId == strict",
          "group": "navigation@1"
        },
        {
          "command": "strict-vscode-client.run",
          "when": "resourceLangId == strict",
          "group": "navigation@2"
        },
        {
          "command": "strict-vscode-client.scrunch.showLineTests",
          "when": "resourceLangId == strict",
          "group": "navigation@3"
        },
        {
          "command": "strict-vscode-client.scrunch.focus",
          "when": "resourceLangId == strict",
          "group": "navigation@4"
        },
        {
          "command": "strict-vscode-client.buildPlatform",
          "when": "resourceLangId == strict",
          "group": "strict@3"
        }
      ],
      "commandPalette": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.run",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.scrunch.focus"
        },
        {
          "command": "strict-vscode-client.scrunch.showLineTests",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.scrunch.slowestTests"
        },
        {
          "command": "strict-vscode-client.scrunch.timeAll"
        },
        {
          "command": "strict-vscode-client.buildNative",
          "when": "resourceLangId == strict"
        },
        {
          "command": "strict-vscode-client.updatePackages",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "strict-vscode-client.selectRoot"
        },
        {
          "command": "strict-vscode-client.evaluate",
          "when": "resourceLangId == strict && editorHasSelection"
        },
        {
          "command": "strict-vscode-client.buildPlatform",
          "when": "resourceLangId == strict || workspaceFolderCount > 0"
        }
      ],
      "explorer/context": [
        {
          "command": "strict-vscode-client.runFile",
          "when": "resourceExtname == .strict || explorerResourceIsFolder",
          "group": "strict@1"
        },
        {
          "command": "strict-vscode-client.run",
          "when": "resourceExtname == .strict || explorerResourceIsFolder",
          "group": "strict@2"
        },
        {
          "command": "strict-vscode-client.buildNative",
          "when": "resourceExtname == .strict || explorerResourceIsFolder",
          "group": "strict@3"
        },
        {
          "command": "strict-vscode-client.updatePackages",
          "when": "explorerResourceIsFolder",
          "group": "strict@4"
        },
        {
          "command": "strict-vscode-client.buildPlatform",
          "when": "resourceExtname == .strict || explorerResourceIsFolder",
          "group": "strict@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "strict-vscode-client.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && resourceLangId == strict"
      },
      {
        "command": "editor.action.quickFix",
        "key": "alt+enter",
        "when": "editorTextFocus && editorHasCodeActionsProvider && resourceLangId == strict"
      },
      {
        "command": "strict-vscode-client.evaluate",
        "key": "shift+enter",
        "when": "editorTextFocus && resourceLangId == strict && editorHasSelection"
      },
      {
        "command": "strict-vscode-client.runFile",
        "key": "f5",
        "when": "editorLangId == strict && !inDebugMode"
      }
    ],
    "taskDefinitions": [
      {
        "type": "strict",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": ".strict file with a Run method (or the file or folder of command), relative to the workspace folder"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments passed to Run"
          },
          "command": {
            "type": "string",
            "enum": [
              "test",
              "check",
              "build",
              "update"
            ],
            "description": "strict command run on file instead of its Run method: test, check, build (native executable) or update (packages)"
          }
        }
      }
    ],
    "configurationDefaults": {
      "files.exclude": {
        "**/*.strictbinary": true,
        "**/*.test": {
          "when": "$(basename).strict"
        },
        "**/*.test.exe": true,
        "**/*.exe": {
          "when": "$(basename).strict"
        },
        "**/*.mlir": {
          "when": "$(basename).strict"
        },
        "**/*.ll": {
          "when": "$(basename).strict"
        }
      },
      "explorer.fileNesting.patterns": {
        "*.strict": "${capture}"
      },
      "[strict]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": true,
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 500,
        "editor.rulers": [
          120
        ]
      }
    },
    "configuration": {
      "title": "Strict",
      "properties": {
        "strict.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "markdownDescription": "SCrunch stops `strict test` of a type after this many seconds (long trainings on the Strict VM need more)."
        },
        "strict.onDemandFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Compiler",
            "Bytecode",
            "Runtime"
          ],
          "markdownDescription": "Types in folders of these names (at any depth) are slow to test, SCrunch tests them when you save them or run them in the Testing view, at start only when their cached result is newer than their file, not when a type they use changed."
        },
        "strict.slowTestMilliseconds": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "markdownDescription": "Tests (and all tests of a method, on its header) and lines of a Run with Coverage taking at least this long show `slow: \u00e2\u20ac\u00a6` after the line and get the `slow` tag (filter the Testing view with `@strict.scrunch:slow`). Most types run all their tests in under 1 ms. **SCrunch: Show Slowest Tests** lists the slowest ones."
        },
        "strict.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Strict folder containing `strict.exe` and the base `.strict` types. Empty = the newest `strict` of the workspace or a sibling `Strict` repository, else the first on PATH, else the copy bundled in the .vsix."
        },
        "strict.suggestImplementations": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Suggest implementations for the selected unfinished method as ghost text. Uses `strict suggest` when available, otherwise `strict test`. Passing tests do not prove equivalence."
        },
        "strict.checkExistingMethods": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show duplicate method bodies (`MethodAlreadyExists`) reported by `strict check`. Does not search for alternatives by running tests."
        }
      }
    },
    "languages": [
      {
        "id": "strict",
        "aliases": [
          "Strict",
          "strict"
        ],
        "extensions": [
          ".strict"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "strict",
        "scopeName": "source.strict",
        "path": "./syntaxes/strict.tmLanguage"
      }
    ],
    "snippets": [
      {
        "language": "strict",
        "path": "./snippets/strict.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "strict",
        "label": "Strict check issues, failed tests and errors",
        "owner": "strict-task",
        "source": "strict",
        "severity": "error",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?=\\s*(?:(?:(?! (?:at|in) ).)+?\\.strict:line \\d+: )?(.*?)(?: (?:at|in) (?:(?! (?:at|in) ).)+?\\.strict:(?:line )?\\d+.*)?$)(?:Test failed: .*? at |\\w+: .*? in |\\s+at \\S+ in )?((?:(?! (?:at|in) ).)+?\\.strict):(?:line )?(\\d+)",
          "message": 1,
          "file": 2,
          "line": 3
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "mutable",
        "description": "Mutable members and variables of Strict, their value changes"
      },
      {
        "id": "test",
        "description": "Names on the test lines of a Strict method"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && bun strict.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test:unit": "bun run compile && bun out/test/unit/runUnitTests.js",
    "test": "bun run test:unit && bun run lint",
    "package": "tsc -p ./ && bun strict.mjs package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.0",
    "@types/vscode": "~1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^10.0.1",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  }
}
