<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus>
  <UserLang name="Strict" ext="strict" udlVersion="2.1">
    <Settings>
      <Global caseIgnored="no" allowFoldOfComments="no" foldCompact="no" forcePureLC="0" decimalSeparator="0" />
      <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
    </Settings>
    <KeywordLists>
      <Keywords name="Keywords1">if else for then from return</Keywords>
      <Keywords name="Keywords2">has constant let with method factory implement returns throws generic create</Keywords>
      <Keywords name="Keywords3">is not and or xor in to get</Keywords>
      <Keywords name="Keywords4">mutable Any any Mutable Mutables</Keywords>
      <Keywords name="Keywords5">None Boolean Booleans Number Numbers Character Characters HashCode Range Ranges Text Texts Error Errors ErrorWithValue ErrorWithValues Iterator Iterators List Lists Type Types Variable Variables Dictionary Dictionaries</Keywords>
      <Keywords name="Keywords6">true false iterator elements value index other outer</Keywords>
      <Keywords name="Keywords7"></Keywords>
      <Keywords name="Keywords8"></Keywords>
    </KeywordLists>
    <Styles>
      <WordsStyle name="DEFAULT"           fgColor="000000" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="COMMENTS"          fgColor="008000" fontName="" fontStyle="2" colorStyle="1" nesting="0" />
      <WordsStyle name="LINE COMMENTS"     fgColor="008000" fontName="" fontStyle="2" colorStyle="1" nesting="0" />
      <WordsStyle name="NUMBERS"           fgColor="098658" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS1"         fgColor="0000FF" fontName="" fontStyle="1" colorStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS2"         fgColor="0000FF" fontName="" fontStyle="1" colorStyle="1" nesting="0" />
