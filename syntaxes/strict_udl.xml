      <WordsStyle name="KEYWORDS4"         fgColor="A31515" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS5"         fgColor="267F99" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS6"         fgColor="0070C1" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS7"         fgColor="000000" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS8"         fgColor="000000" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
      <WordsStyle name="OPERATORS"         fgColor="795E26" fontName="" fontStyle="0" colorStyle="1" nesting="0" />
